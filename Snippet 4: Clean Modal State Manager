// --- MODAL CONTROLLER UTILITIES ---
function openAppModal(modalId, menuToCloseId = null) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.add('active');
    }
    
    // Clean up any open floating menus behind the modal
    if (menuToCloseId) {
        const menu = document.getElementById(menuToCloseId);
        if (menu) menu.classList.remove('active');
    }
}

function closeAppModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.remove('active');
    }
}
